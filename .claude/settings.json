{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start.sh\"" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/nudge.sh\"" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/build_index.py)",
      "Bash(python3 scripts/recall.py:*)",
      "Bash(wc -m .claude/memory/*)"
    ]
  }
}
